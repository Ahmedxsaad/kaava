{
  "title": "Blueprints Talk: how it is built",
  "subtitle": "One FastAPI app in a container on a 2-vCPU VM: exact engines first, one vision model behind them, every paid answer kept",
  "destination": "slide",
  "theme": "sketch",
  "zones": [
    {
      "id": "front",
      "label": "In the browser",
      "color": "client"
    },
    {
      "id": "vm",
      "label": "Azure VM · Docker",
      "color": "service"
    },
    {
      "id": "engines",
      "label": "Engines · plain code, on CPU",
      "color": "data",
      "parent": "vm"
    },
    {
      "id": "outside",
      "label": "Outside · paid",
      "color": "ai"
    }
  ],
  "nodes": [
    {
      "id": "user",
      "label": "Engineer",
      "zone": "front",
      "shape": "ellipse"
    },
    {
      "id": "web",
      "label": "Verification UI",
      "sub": "React · SVG · three.js",
      "zone": "front",
      "icon": "logos:React"
    },
    {
      "id": "cf",
      "label": "Cloudflare Tunnel",
      "sub": "no open port on the VM",
      "icon": "brands:Cloudflare",
      "color": "infra"
    },
    {
      "id": "api",
      "label": "Router + verifier",
      "sub": "FastAPI · Python 3.12",
      "zone": "vm",
      "icon": "brands:FastAPI",
      "highlight": true
    },
    {
      "id": "ifc",
      "label": "IFC engine",
      "sub": "IfcOpenShell",
      "zone": "engines",
      "icon": "logos:Python"
    },
    {
      "id": "dxf",
      "label": "DXF engine",
      "sub": "ezdxf + shapely",
      "zone": "engines",
      "icon": "logos:Python"
    },
    {
      "id": "ocr",
      "label": "Label reader",
      "sub": "RapidOCR (PP-OCR)",
      "zone": "engines",
      "icon": "it:Document"
    },
    {
      "id": "tools",
      "label": "Sheet tools",
      "sub": "calculator · ruler · tiles",
      "zone": "engines",
      "icon": "brands:NumPy"
    },
    {
      "id": "cache",
      "label": "Cache on disk",
      "sub": "indexes · meshes · readings",
      "zone": "vm",
      "icon": "sysdesign:Key-value store"
    },
    {
      "id": "gemini",
      "label": "Gemini 4 Carbon",
      "sub": "boxes, workings, examiners",
      "zone": "outside",
      "icon": "brands:Google Gemini"
    }
  ],
  "edges": [
    {
      "from": "user",
      "to": "web",
      "step": 1,
      "label": "Engineer asks, sees the evidence"
    },
    {
      "from": "web",
      "to": "cf",
      "step": 2,
      "label": "Request goes through the tunnel",
      "both": true
    },
    {
      "from": "cf",
      "to": "api",
      "both": true
    },
    {
      "from": "api",
      "to": "ifc"
    },
    {
      "from": "api",
      "to": "dxf",
      "step": 3,
      "label": "Engine computes from the file"
    },
    {
      "from": "api",
      "to": "ocr"
    },
    {
      "from": "api",
      "to": "tools",
      "step": 4,
      "label": "No exact data: the sheet tools"
    },
    {
      "from": "tools",
      "to": "gemini",
      "step": 5,
      "label": "Model points; code computes",
      "style": "dotted"
    },
    {
      "from": "api",
      "to": "cache",
      "style": "dashed",
      "label": "kept"
    }
  ],
  "legend": {
    "highlight": "decides the method and the state",
    "dotted": "paid call, only when needed",
    "dashed": "written to disk",
    "infra": "the way in from the internet"
