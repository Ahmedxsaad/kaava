{
  "type": "sequence",
  "theme": "sketch",
  "numbered": true,
  "title": "The model never writes the number",
  "subtitle": "A real question on one of Stoa's sample sheets: the area of the 150 mm slab, which has two trenches cut into it",
  "participants": [
    {
      "id": "eng",
      "label": "Engineer",
      "icon": "people:Guy",
      "color": "client"
    },
    {
      "id": "app",
      "label": "Program",
      "sub": "plain code",
      "icon": "logos:Python",
      "color": "service",
      "highlight": true
    },
    {
      "id": "ocr",
      "label": "Sheet reader",
      "sub": "local OCR",
      "icon": "it:Document",
      "color": "data"
    },
    {
      "id": "llm",
      "label": "Reader",
      "sub": "Gemini 4 Carbon",
      "icon": "brands:Google Gemini",
      "color": "ai"
    },
    {
      "id": "exam",
      "label": "Two examiners",
      "sub": "Gemini, independent",
      "icon": "brands:Google Gemini",
      "color": "ai"
    },
    {
      "id": "calc",
      "label": "Calculator",
      "sub": "and a ruler in pixels",
      "color": "output"
    }
  ],
  "messages": [
    {
      "from": "eng",
      "to": "app",
      "label": "Area of the 150 mm slab, in m2?"
    },
    {
      "from": "app",
      "to": "ocr",
      "label": "read every text at full size"
    },
    {
      "from": "ocr",
      "to": "app",
      "label": "274 texts, each with its box",
      "reply": true
    },
    {
      "from": "app",
      "to": "llm",
      "label": "sheet image + the 274 texts"
    },
    {
      "from": "llm",
      "to": "app",
      "label": "a = 6200, b = 9950, formula a * b",
      "reply": true,
      "note": "the reply format has no field for the answer"
    },
    {
      "from": "app",
      "to": "calc",
      "label": "6200 * 9950, after re-reading both figures"
    },
    {
      "from": "calc",
      "to": "app",
      "label": "61.69 m2",
      "reply": true
    },
    {
      "from": "app",
      "to": "exam",
      "label": "the working + an enlarged view: what is inside?"
    },
    {
      "from": "exam",
      "to": "app",
      "label": "two trenches, widths not printed",
      "reply": true,
      "note": "nobody estimates by eye: they point at the 9950 dimension as the scale"
    },
    {
      "from": "app",
      "to": "calc",
      "label": "measure both trenches in the pixels"
    },
    {
      "from": "calc",
      "to": "app",
      "label": "61.69 - 1.70 - 0.67 = 59.32 m2",
      "reply": true
    },
    {
      "from": "app",
      "to": "eng",
      "label": "Check this: 59.32 m2, trenches marked",
      "reply": true
    }
  ],
  "groups": [
    {
      "kind": "critical",
      "label": "both examiners must find the same parts, or nothing is taken out",
      "from": 8,
      "to": 9
    }
  ],
  "legend": {
    "client": "person",
    "service": "our code",
    "data": "our code: reads the sheet",
    "ai": "language model: points, never computes",
    "output": "our code: arithmetic and pixels"
  }
}
