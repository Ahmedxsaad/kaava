# Copy to .env (git-ignored) and fill in. Never commit or print real keys.
# Everything is optional: the exact engines need no key at all.

# Gemini: the vision model for scans, and the language model that restates questions
# the rules cannot read. https://aistudio.google.com/
GEMINI_API_KEY=

# Claude: used instead of Gemini while no Gemini key is set.
ANTHROPIC_API_KEY=

# Cloudinary: prepares drawings people bring (size, colour, AI enlargement of small
# scans) and hosts the evidence sheets they share. https://cloudinary.com/
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ElevenLabs: reads answers aloud with a natural voice (the browser's voice otherwise).
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL_ID=

# Most the web app may spend on model calls per server start, in euros (default 1.0)
# BLUEPRINTS_UI_BUDGET_EUR=1.0

# Aiven for PostgreSQL: the log of questions asked of the app (what was asked and how it ended, never
# who asked), read back as live figures on the Numbers page. A PostgreSQL address whose login owns a
# schema named "kaava"; the app creates its one table there. https://aiven.io/
# KAAVA_PG_URL=postgres://user:password@host:port/defaultdb?sslmode=require
